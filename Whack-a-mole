import sys
import random
from PyQt6.QtWidgets import (
    QApplication,
    QMainWindow,
    QPushButton,
    QGridLayout,
    QWidget,
    QLabel,
    QVBoxLayout
)
from PyQt6.QtCore import Qt, QTimer

class MyFirstWindow(QMainWindow):

    def __init__(self):
        super().__init__()

        self.setWindowTitle("Whack-a-Mole!")

        # Initialize game variables
        self.score = 0
        self.mole_row = -1
        self.mole_col = -1
# --- Speed Tracking and Levels System ---
# Speed and streak tracker
        self.consecutive_hits = 0
        self.speed_level = 0
# Speed in milliseconds (level 0 is the slowest and the levels become faster)
        self.speed_levels = [2000, 1600, 1200, 900, 600, 400]

        # Central widget and main layout (Grassy green background)
        central_widget = QWidget()
        central_widget.setStyleSheet("background-color: #2e8b57;")
        self.setCentralWidget(central_widget)
        main_layout = QVBoxLayout(central_widget)

        # Scoreboard displaying the current amount of points and now levels
        self.score_label = QLabel("Score: 0 | Level: 1")
        self.score_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.score_label.setStyleSheet(
            "font-size: 22px; font-weight: bold; color: white;"
        )
        main_layout.addWidget(self.score_label)

        # The grid layout and the buttons list
        grid_layout = QGridLayout()
        self.buttons = []

        for row in range(3):
            row_buttons = []
            for col in range(3):
                # New button system style giving each hole button a different appearance
                button = QPushButton("🕳️ Hole")
                button.setFixedSize(110, 110)
                button.setStyleSheet("""
                    background-color: #3b2219;
                    color: #a67c52;
                    border: 5px solid #1a0f0a;
                    border-radius: 55px;
                    font-size: 14px;
                    font-weight: bold;
                """)
                grid_layout.addWidget(button, row, col)
                row_buttons.append(button)

                button.clicked.connect(
                    lambda checked, r=row, c=col: self.button_clicked(r, c)
                )

            self.buttons.append(row_buttons)

        # Nest the grid layout inside the main vertical layout
        main_layout.addLayout(grid_layout)

        # Setup QTimer for the moving target/mole
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.move_mole)

        # Start timer with initial speed level
        self.update_timer_speed()

        # Spawn the first mole
        self.move_mole()

    def update_timer_speed(self):
        # Get current interval based on speed level (cap at max level index)
        interval = self.speed_levels[min(self.speed_level, len(self.speed_levels) - 1)]
        self.timer.start(interval)

    def move_mole(self):
        # Reset all buttons back to default "Hole" state
        for r in range(3):
            for c in range(3):
                self.buttons[r][c].setText("🕳️ Hole")
                self.buttons[r][c].setStyleSheet("""
                    background-color: #3b2219;
                    color: #a67c52;
                    border: 5px solid #1a0f0a;
                    border-radius: 55px;
                    font-size: 14px;
                    font-weight: bold;
                """)

        # Pick a new random row and column for the mole
        self.mole_row = random.randint(0, 2)
        self.mole_col = random.randint(0, 2)

        # Set the mole button appearance (Pop-up brown mole style)
        self.buttons[self.mole_row][self.mole_col].setText("🐹 MOLE!")
        self.buttons[self.mole_row][self.mole_col].setStyleSheet("""
            background-color: #d28c46;
            color: white;
            border: 5px solid #8b4513;
            border-radius: 55px;
            font-size: 14px;
            font-weight: bold;
        """)

    def button_clicked(self, row, col):
        print(f"({row},{col}) was hit")

        # Check if the clicked button matches the moving target/mole's position
        if row == self.mole_row and col == self.mole_col:
            self.score += 1
            self.consecutive_hits += 1
            print(f"Hit! Score: {self.score}, Streak: {self.consecutive_hits}")

            # Check if the player hits 4 in a row to level up!
            if (
                self.consecutive_hits >= 4 
                and self.speed_level < len(self.speed_levels) - 1
            ):
                self.speed_level += 1
                self.consecutive_hits = 0  # Reset streak for the next level
                print(f"Speed increased! Now at Level {self.speed_level + 1}")

            # Correct hit (A flashy green light)
            self.buttons[row][col].setText("✨ Ouch!")
            self.buttons[row][col].setStyleSheet("""
                background-color: #2ecc71;
                color: white;
                border: 5px solid #27ae60;
                border-radius: 55px;
                font-size: 14px;
                font-weight: bold;
            """)

            # Update timer with current speed and spawn a new mole
            self.update_timer_speed()
            self.move_mole()
        else:
            print("Missed!")
            # Reset the streak and decrease speed level by 1 (minimum level 0)
            self.consecutive_hits = 0
            if self.speed_level > 0:
                self.speed_level -= 1
                print(f"Missed! Speed decreased to Level {self.speed_level + 1}")

            self.score_label.setText(
                f"Score: {self.score} | Level: {self.speed_level + 1}"
            )
            self.update_timer_speed()
            # When the moving target is missed this will run
            self.buttons[row][col].setText("❌ Miss")
            self.buttons[row][col].setStyleSheet("""
                background-color: #e74c3c;
                color: white;
                border: 5px solid #c0392b;
                border-radius: 55px;
                font-size: 14px;
                font-weight: bold;
            """)


if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = MyFirstWindow()
    window.show()
    sys.exit(app.exec())
